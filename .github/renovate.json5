{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:best-practices',
        ':approveMajorUpdates',
    ],
    packageRules: [
        {
            matchUpdateTypes: [
                'patch',
            ],
            groupName: 'all patch dependencies',
            groupSlug: 'all-patch',
            matchPackageNames: [
                '*',
            ],
        },
    ],
}
